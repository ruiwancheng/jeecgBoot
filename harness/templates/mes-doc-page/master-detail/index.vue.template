<!-- @generated-from: harness/templates/mes-doc-page/master-detail @version: 1.0.0 -->
<template>
  <div>
    <BasicTable @register="registerTable" :rowSelection="rowSelection">
      <!-- 模式 3：明细子表展开行 -->
      <template #expandedRowRender="{ record }">
        <ItemsSubTable :docId="record.id" />
      </template>
      <template #tableTitle>
        <a-button type="primary" preIcon="ant-design:plus-outlined" @click="handleAdd">新增{{BIZ_NAME}}单</a-button>
        <a-button type="primary" preIcon="ant-design:export-outlined" @click="onExportXls">导出</a-button>
        <a-divider type="vertical" />
        <!-- 模式 2：批量审核/反审核（状态守卫：全选同状态才可用） -->
        <a-button type="primary" :disabled="allStatus != '1'" @click="batchAudit">审核</a-button>
        <a-button danger :disabled="allStatus != '2'" @click="batchUnaudit">反审核</a-button>
      </template>
      <template #statusTag="{ record }">
        <a-tag :color="record.status === '2' ? 'green' : 'orange'">{{ record.status_dictText || (record.status === '2' ? '已审核' : '草稿') }}</a-tag>
      </template>
      <template #action="{ record }">
        <TableAction :actions="getActions(record)" />
      </template>
    </BasicTable>
    <DocDrawer @register="registerDrawer" @success="reload" />
  </div>
</template>

<script lang="ts" setup>
  import { computed, reactive } from 'vue';
  import { BasicTable, TableAction } from '/@/components/Table';
  import { useListPage } from '/@/hooks/system/useListPage';
  import { useDrawer } from '/@/components/Drawer';
  import { columns, searchFormSchema } from './data';
  import { queryList, deleteDoc, auditDoc, unauditDoc, getExportUrl } from './api';
  import DocDrawer from './Drawer.vue';
  import ItemsSubTable from './ItemsSubTable.vue';
  import { message } from 'ant-design-vue';

  defineOptions({ name: '{{PAGE_COMPONENT}}' });
  const [registerDrawer, { openDrawer }] = useDrawer();

  // 模式 2：复选框
  const selectedRowKeys = reactive<string[]>([]);
  const selectedRows = reactive<Recordable[]>([]);
  const rowSelection = {
    type: 'checkbox' as const,
    columnWidth: 50,
    selectedRowKeys,
    onChange(keys: string[], rows: Recordable[]) {
      selectedRowKeys.length = 0;
      selectedRowKeys.push(...keys);
      selectedRows.length = 0;
      selectedRows.push(...rows);
    },
  };
  const allStatus = computed(() => {
    if (!selectedRows.length) return '';
    const s = selectedRows[0].status;
    return selectedRows.every((r) => r.status === s) ? s : '';
  });

  const { tableContext, onExportXls } = useListPage({
    designScope: '{{MENU_ID}}',
    tableProps: { title: '{{BIZ_NAME}}', api: queryList, columns, rowKey: 'id', formConfig: { labelWidth: 120, schemas: searchFormSchema } },
    exportConfig: { name: '{{BIZ_NAME}}', url: getExportUrl },
  });

  const [registerTable, { reload }] = tableContext;

  // 模式 7+10：操作列按状态显隐 + 删除 popConfirm
  function getActions(r: Recordable) {
    const acts: any[] = [];
    if (r.status == '1') {
      acts.push({ label: '编辑', onClick: () => openDrawer(true, { record: r, isUpdate: true }) });
      acts.push({ label: '删除', popConfirm: { title: '确认删除？', confirm: () => handleDelete(r) } });
    }
    return acts;
  }

  function handleAdd() { openDrawer(true, { isUpdate: false }); }
  async function handleDelete(r: Recordable) { await deleteDoc({ id: r.id }); message.success('删除成功'); reload(); }
  async function batchAudit() { for (const r of selectedRows) { await auditDoc({ id: r.id }); } message.success(`已审核${selectedRowKeys.length}条`); selectedRowKeys.length = 0; selectedRows.length = 0; reload(); }
  async function batchUnaudit() { for (const r of selectedRows) { await unauditDoc({ id: r.id }); } message.success(`已反审核${selectedRowKeys.length}条`); selectedRowKeys.length = 0; selectedRows.length = 0; reload(); }
</script>
