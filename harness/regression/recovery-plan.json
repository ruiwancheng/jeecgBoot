{
  "version": 2,
  "name": "MES regression recovery 2026-08-04 (FULL: 30 slices + chain)",
  "report_path": "hermes/eagle-eye/reports/${date}/resilient-regression-recovery.md",
  "report_paths": [
    "hermes/eagle-eye/reports/${date}/resilient-regression-recovery.md"
  ],
  "report_mirror_paths": [
    "/Users/ruisuyun/Documents/笔记空间/低代码平台方案/03测试/${date}/resilient-regression-recovery.md"
  ],
  "environment": {
    "HARNESS_BASE": "http://127.0.0.1:8080/jeecg-boot",
    "E2E_API_BASE": "http://127.0.0.1:8080/jeecg-boot",
    "E2E_UI_BASE": "http://127.0.0.1:3100",
    "PLAYWRIGHT_BASE_URL": "http://127.0.0.1:3100"
  },
  "health": {
    "backend": {
      "url": "http://127.0.0.1:8080/jeecg-boot/sys/getEncryptedString",
      "timeout_seconds": 5,
      "contains": "success"
    },
    "frontend": {
      "url": "http://127.0.0.1:3100/",
      "timeout_seconds": 5,
      "contains": "<"
    }
  },
  "static_checks": {
    "scanner": "test-quality",
    "root": "harness/tests",
    "tests_root": "harness/tests/modules",
    "frontend_root": "jeecgboot-vue3",
    "fail_threshold": 0.3
  },
  "services": [
    {
      "id": "backend",
      "max_restarts": 2,
      "startup_timeout_seconds": 180,
      "start": {
        "cwd": ".",
        "command": [
          "java",
          "-jar",
          "jeecg-boot/jeecg-module-system/jeecg-system-start/target/jeecg-system-start-3.9.2.jar",
          "--spring.profiles.active=dev",
          "--spring.flyway.enabled=false"
        ]
      }
    },
    {
      "id": "frontend",
      "max_restarts": 2,
      "startup_timeout_seconds": 60,
      "start": {
        "cwd": "jeecgboot-vue3",
        "command": [
          "pnpm",
          "dev",
          "--host",
          "127.0.0.1"
        ]
      }
    }
  ],
  "slices": [
    {
      "id": "0-build",
      "name": "完整构建后端并安装本地依赖",
      "kind": "build",
      "cwd": "jeecg-boot",
      "command": [
        "mvn",
        "compile",
        "-pl",
        "jeecg-boot-module/project-mes",
        "-am",
        "-DskipTests",
        "-q"
      ],
      "timeout_seconds": 1800,
      "requires": [],
      "continue_on_failure": false
    },
    {
      "id": "frontend-static",
      "name": "前端类型检查与构建验证",
      "kind": "frontend-static",
      "cwd": "jeecgboot-vue3",
      "command": [
        "pnpm",
        "run",
        "typecheck"
      ],
      "fallback_command": [
        "npx",
        "vue-tsc",
        "--noEmit"
      ],
      "timeout_seconds": 360,
      "requires": [
        "frontend"
      ],
      "verdict_when_failed": "test_design_issue"
    },
    {
      "id": "test-quality",
      "name": "API 测试断言质量扫描 (R009)",
      "kind": "quality",
      "cwd": ".",
      "command": [
        "python3",
        "harness/scripts/regression_plan.py",
        "report",
        "--root",
        "harness/tests/modules"
      ],
      "timeout_seconds": 60,
      "requires": []
    },
    {
      "id": "smoke-api",
      "name": "变更感知冒烟 (核心接口)",
      "kind": "module",
      "cwd": "harness",
      "command": [
        "node",
        "tests/modules/basic.test.js"
      ],
      "timeout_seconds": 240,
      "requires": [
        "backend"
      ]
    },
    {
      "id": "smoke-e2e",
      "name": "变更感知冒烟 (核心 E2E)",
      "kind": "e2e",
      "cwd": "harness",
      "command": [
        "npx",
        "playwright",
        "test",
        "e2e/mes/basic.spec.ts",
        "--workers=1"
      ],
      "timeout_seconds": 240,
      "requires": [
        "backend",
        "frontend"
      ]
    },
    {
      "id": "1.1",
      "name": "采购申请到订单",
